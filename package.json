{
  "name": "mochi-pet",
  "version": "1.0.0",
  "private": true,
  "description": "A cross-platform desktop pet for macOS and Windows.",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "package:mac": "electron-packager . Mochi-Pet --platform=darwin --arch=arm64 --out=release --overwrite",
    "package:win": "electron-packager . Mochi-Pet --platform=win32 --arch=x64 --out=release --overwrite"
  },
  "devDependencies": {
    "@electron/packager": "^20.0.1",
    "electron": "^43.2.0"
  }
}
